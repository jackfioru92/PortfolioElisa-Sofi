---
import '../styles/global.css';
import { useTranslations, type Lang } from '../i18n/ui';
import DeckNav from '../components/DeckNav.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = 'https://secreative.it';
const canonical = lang === 'it' ? `${site}/` : `${site}/en/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'SE Creative',
  description: t('meta.desc'),
  url: site,
  email: 'secreative06@gmail.com',
  telephone: '+393514374436',
  image: `${site}/img/logo/se-creative.png`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Perugia',
    addressRegion: 'Umbria',
    addressCountry: 'IT',
  },
  founder: [
    { '@type': 'Person', name: 'Sofia Ercolani' },
    { '@type': 'Person', name: 'Elisa Zetti' },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.desc')} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="it" href={`${site}/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SE Creative" />
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.desc')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/img/deck/s01.webp`} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/img/logo/icon-512.png" type="image/png" />
    <link rel="apple-touch-icon" href="/img/logo/apple-touch-icon.png" />

    <link rel="preload" as="image" href="/img/deck/s01.webp" fetchpriority="high" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <DeckNav lang={lang} />
    <main>
      <slot />
    </main>

    {/* per i motori di ricerca e per chi non ha JavaScript */}
    <noscript>
      <div class="ns">
        <h1>SE Creative — Portfolio 2026</h1>
        <p>Elisa Zetti &amp; Sofia Ercolani — Brand Identity, Packaging, Social Media, Video.</p>
        <p>secreative06@gmail.com — +39 351 437 4436</p>
      </div>
    </noscript>

    <style>
      .ns {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: grid;
        place-content: center;
        gap: 0.75rem;
        text-align: center;
        background: #000;
        color: #fff;
        padding: 2rem;
      }
    </style>
  </body>
</html>
