---
import '@fontsource-variable/manrope';
import '@fontsource/bodoni-moda/latin-500-italic.css';
import '../styles/sito.css';
import { studio, percorso, type Lingua } from '../data/studio';
import { t } from '../data/testi';
import Puntatore from '../components/sito/Puntatore.astro';

interface Props {
  lang: Lingua;
  /** titolo e descrizione della home, se non si passa nulla */
  titolo?: string;
  descrizione?: string;
}
const { lang, titolo, descrizione } = Astro.props;
const testi = t(lang);

const site = 'https://secreative.it';
const meta = {
  titolo: titolo ?? testi.meta.titolo,
  descrizione: descrizione ?? testi.meta.descrizione,
};

/* il canonico è la pagina che si sta guardando, non sempre la home */
const canonico = new URL(Astro.url.pathname, site).href;
const altra: Lingua = lang === 'it' ? 'en' : 'it';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: studio.nome,
  description: meta.descrizione,
  url: site,
  email: studio.email,
  telephone: studio.telefonoRaw,
  image: `${site}/img/logo/se-creative.png`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Perugia',
    addressRegion: 'Umbria',
    addressCountry: 'IT',
  },
  founder: [
    { '@type': 'Person', name: 'Sofia Ercolani' },
    { '@type': 'Person', name: 'Elisa Zetti' },
  ],
  sameAs: [`https://instagram.com/${studio.instagram}`],

  /* Dove si lavora: senza questo, per i motori lo studio è un indirizzo a
     Perugia e basta, e le ricerche fatte dal resto della regione non lo
     incrociano. */
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Umbria' },
    { '@type': 'AdministrativeArea', name: 'Provincia di Perugia' },
    { '@type': 'AdministrativeArea', name: 'Provincia di Terni' },
    { '@type': 'City', name: 'Perugia' },
    { '@type': 'City', name: 'Corciano' },
    { '@type': 'City', name: 'Magione' },
    { '@type': 'City', name: 'Assisi' },
    { '@type': 'City', name: 'Foligno' },
    { '@type': 'City', name: 'Terni' },
    { '@type': 'Country', name: 'Italia' },
  ],

  /* Il centro della zona servita, con il raggio: è quello che i motori usano
     per decidere se mostrare lo studio a chi cerca «qui vicino». */
  serviceArea: {
    '@type': 'GeoCircle',
    geoMidpoint: { '@type': 'GeoCoordinates', latitude: 43.1107, longitude: 12.3908 },
    geoRadius: 70000,
  },

  knowsLanguage: ['it', 'en'],

  /* L'elenco dei servizi, nelle parole con cui la gente li cerca */
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: lang === 'it' ? 'Servizi' : 'Services',
    itemListElement: (lang === 'it'
      ? [
          'Logo e brand identity',
          'Packaging e stampa',
          'Social media strategy e gestione profili',
          'Creative visual e fotomanipolazione',
          'Video e reel per i social',
          'Siti web e applicazioni',
        ]
      : [
          'Logo and brand identity',
          'Packaging and print',
          'Social media strategy and account management',
          'Creative visual and photo manipulation',
          'Video and reels for social media',
          'Websites and apps',
        ]
    ).map((nome) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: nome },
    })),
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.titolo}</title>
    <meta name="description" content={meta.descrizione} />
    <link rel="canonical" href={canonico} />

    <link rel="alternate" hreflang="it" href={`${site}/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studio.nome} />
    <meta property="og:title" content={meta.titolo} />
    <meta property="og:description" content={meta.descrizione} />
    <meta property="og:url" content={canonico} />
    <meta property="og:image" content={`${site}/img/deck/s01.webp`} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#fab415" />
    <link rel="icon" href="/img/logo/icon-512.png" type="image/png" />
    <link rel="apple-touch-icon" href="/img/logo/apple-touch-icon.png" />

    <link rel="preload" as="image" href="/img/work/beyond-the-visual.webp" fetchpriority="high" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <Puntatore />
    <slot />

    <script>
      /**
       * Testo che si scrive da solo, come nella storia di riferimento.
       * Si attiva su qualsiasi elemento con `data-scrivi` e parte quando
       * quell'elemento entra davvero nello schermo, non al caricamento:
       * altrimenti chi arriva piu' in basso lo troverebbe gia' finito.
       *
       * Il testo vero resta sempre nella pagina, nascosto alla vista ma
       * leggibile da Google e dagli screen reader: a scriversi e' una copia
       * marcata `aria-hidden`. Cosi' l'effetto non toglie niente a nessuno.
       */

      /**
       * Titoli che si rivelano entrando in vista: il testo sale da sotto una
       * riga invisibile, riga per riga. Serve spezzare il titolo in righe, e
       * le righe le decide il browser: si misura dove va a capo davvero, con
       * i Range, invece di indovinare dai tag.
       */
      const daRivelare = document.querySelectorAll<HTMLElement>('[data-rivela]');

      if (daRivelare.length) {
        const fermoTesto = matchMedia('(prefers-reduced-motion: reduce)').matches;

        daRivelare.forEach((titolo) => {
          if (fermoTesto) {
            titolo.classList.add('rivelato');
            return;
          }

          new IntersectionObserver(
            (voci, osservatore) => {
              for (const v of voci) {
                if (!v.isIntersecting) continue;
                osservatore.disconnect();
                titolo.classList.add('rivelato');
              }
            },
            { threshold: 0.25 }
          ).observe(titolo);
        });
      }

      /**
       * I numeri salgono dal valore di partenza a quello d'arrivo.
       * Il testo scritto nella pagina resta il valore finale: se il copione
       * non parte, si legge comunque il numero giusto.
       */
      const daContare = document.querySelectorAll<HTMLElement>('[data-conta]');

      if (daContare.length) {
        const fermoNumeri = matchMedia('(prefers-reduced-motion: reduce)').matches;

        /**
         * "26,1k" vale 26100, "1.900" vale 1900: si legge sempre in unità
         * vere, altrimenti un conteggio che parte da "1.000" e arriva a "14k"
         * salirebbe da mille a quattordici.
         */
        const leggi = (testo: string) => {
          const ripulito = testo.trim();
          const k = /k$/i.test(ripulito);
          const corpo = ripulito.replace(/k$/i, '').replace(/\./g, '').replace(',', '.');
          const grezzo = parseFloat(corpo);
          const valore = Number.isFinite(grezzo) ? grezzo : 0;
          return {
            valore: k ? valore * 1000 : valore,
            k,
            decimali: (corpo.split('.')[1] || '').length,
          };
        };

        /** riscrive un valore nella forma del traguardo */
        const scrivi = (n: number, come: { k: boolean; decimali: number }) => {
          if (come.k) {
            const migliaia = n / 1000;
            // sotto il mille la "k" non ha senso: meglio il numero intero
            if (migliaia < 1) return Math.round(n).toLocaleString('it-IT');
            return migliaia.toFixed(come.decimali).replace('.', ',') + 'k';
          }
          // toLocaleString non mette sempre il punto sulle quattro cifre
          return Math.round(n)
            .toString()
            .replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        };

        daContare.forEach((el) => {
          const arrivo = leggi(el.textContent || '');
          const partenza = leggi(el.dataset.conta || '0');
          if (fermoNumeri || arrivo.valore === partenza.valore) return;

          el.textContent = scrivi(partenza.valore, arrivo);

          const DURATA = 1500;
          let inizio = 0;

          const salita = (ora: number) => {
            if (!inizio) inizio = ora;
            const quota = Math.min((ora - inizio) / DURATA, 1);
            // parte svelto e rallenta alla fine
            const morbida = 1 - Math.pow(1 - quota, 3);
            const valore = partenza.valore + (arrivo.valore - partenza.valore) * morbida;
            el.textContent = scrivi(valore, arrivo);
            if (quota < 1) requestAnimationFrame(salita);
          };

          new IntersectionObserver(
            (voci, osservatore) => {
              for (const v of voci) {
                if (!v.isIntersecting) continue;
                osservatore.disconnect();
                requestAnimationFrame(salita);
              }
            },
            { threshold: 0.6 }
          ).observe(el);
        });
      }

      const daScrivere = document.querySelectorAll<HTMLElement>('[data-scrivi]');

      if (daScrivere.length) {
        const fermo = matchMedia('(prefers-reduced-motion: reduce)').matches;

        const VELOCITA = 22; // millisecondi per carattere (~45 al secondo)
        const RESPIRO = 180; // pausa in piu' dopo un punto

        daScrivere.forEach((el) => {
          const testo = (el.textContent || '').trim();
          if (!testo) return;

          el.textContent = '';

          const vero = document.createElement('span');
          vero.className = 'solo-lettori';
          vero.textContent = testo;

          const finto = document.createElement('span');
          finto.setAttribute('aria-hidden', 'true');

          el.append(vero, finto);

          // a movimento ridotto il testo c'e' e basta
          if (fermo) {
            finto.textContent = testo;
            return;
          }

          // lo spazio resta occupato: la pagina non sobbalza mentre scrive
          el.style.minHeight = `${el.getBoundingClientRect().height}px`;

          let i = 0;
          const scrivi = () => {
            finto.textContent = testo.slice(0, ++i);
            if (i >= testo.length) {
              el.style.minHeight = '';
              return;
            }
            const appenaScritto = testo[i - 1];
            setTimeout(scrivi, appenaScritto === '.' ? VELOCITA + RESPIRO : VELOCITA);
          };

          new IntersectionObserver(
            (voci, osservatore) => {
              for (const v of voci) {
                if (!v.isIntersecting) continue;
                osservatore.disconnect();
                setTimeout(scrivi, 160);
              }
            },
            { threshold: 0.6 }
          ).observe(el);
        });
      }
    </script>

    <style is:global>
      /* i titoli entrano salendo da sotto una riga invisibile */
      [data-rivela] {
        opacity: 0;
        transform: translateY(0.4em);
        transition:
          opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
          transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      }
      [data-rivela].rivelato {
        opacity: 1;
        transform: none;
      }
      /* se il copione non parte, il titolo non puo' restare invisibile */
      .no-js [data-rivela] {
        opacity: 1;
        transform: none;
      }

      /* il testo vero: c'e', ma non si vede */
      .solo-lettori {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
      }
    </style>
  </body>
</html>
