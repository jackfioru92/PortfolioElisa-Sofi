---
import { useTranslations, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * `video`: percorso del file in /public/video/ (es. '/video/borgobrufa.mp4').
 * Finché è null la card mostra l'anteprima con l'etichetta "video in arrivo".
 * Per attivare un video basta caricare il file e scrivere qui il suo percorso.
 */
const reels = [
  { key: 'reels.b23', poster: '/img/reels/r24_01.webp', logo: '/img/brands/b23.webp', video: null },
  { key: 'reels.b25', poster: '/img/reels/r26_04.webp', logo: '/img/brands/b25.webp', video: null },
  { key: 'reels.b27', poster: '/img/reels/r28_07.webp', logo: '/img/brands/b27.webp', video: null },
  { key: 'reels.b29', poster: '/img/reels/r30_10.webp', logo: '/img/brands/b29.webp', video: null },
  { key: 'reels.b31', poster: '/img/reels/r32_13.webp', logo: '/img/brands/b31.webp', video: null },
  { key: 'reels.b33', poster: '/img/reels/r34_16.webp', logo: '/img/brands/b33.webp', video: null },
] as const;
---

<section class="reels" id="reels">
  <div class="wrap">
    <p class="label pre" data-reveal>{t('reels.label')}</p>
    <div class="head">
      <h2 class="h-sec pre" data-lines>
        <span class="line"><span>{t('reels.title')}</span></span>
      </h2>
      <p class="lead pre" data-reveal data-reveal-delay="0.12">{t('reels.intro')}</p>
    </div>

    <ul class="rail">
      {
        reels.map((r, i) => {
          const name = t(r.key as any);
          return (
            <li class="card pre" data-reveal data-reveal-delay={(i % 3) * 0.07}>
              <div class="frame">
                <img
                  src={r.poster}
                  alt={name}
                  width="720"
                  height="1280"
                  loading="lazy"
                  decoding="async"
                />
                <img class="logo" src={r.logo} alt="" loading="lazy" />

                {r.video ? (
                  <button
                    class="play"
                    data-video={r.video}
                    data-name={name}
                    aria-label={`${t('reels.play')} — ${name}`}
                  >
                    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                      <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
                    </svg>
                  </button>
                ) : (
                  <span class="soon">{t('reels.soon')}</span>
                )}
              </div>
              <p class="name">{name}</p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<dialog class="lb" id="lightbox" aria-label="Video">
  <button class="lb-x" aria-label="×" data-close>&times;</button>
  <video controls playsinline preload="none"></video>
</dialog>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  const vid = dlg?.querySelector('video') as HTMLVideoElement | null;

  if (dlg && vid) {
    document.querySelectorAll<HTMLButtonElement>('.play[data-video]').forEach((btn) => {
      btn.addEventListener('click', () => {
        vid.src = btn.dataset.video!;
        dlg.showModal();
        // parte solo qui: è il click dell'utente sul tasto play
        vid.play().catch(() => {});
        (window as any).__lenis?.stop();
      });
    });

    const close = () => {
      vid.pause();
      vid.removeAttribute('src');
      vid.load();
      dlg.close();
      (window as any).__lenis?.start();
    };

    dlg.querySelector('[data-close]')?.addEventListener('click', close);
    dlg.addEventListener('close', () => (window as any).__lenis?.start());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) close();
    });
  }
</script>

<style>
  .reels {
    background: var(--bg-soft);
    border-block: 1px solid var(--line);
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem 4rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 7vh, 5rem);
  }

  .rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .frame {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 6px;
    background: var(--bg-card);
    isolation: isolate;
  }
  .frame > img:first-child {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease), filter 0.5s;
    filter: saturate(0.92);
  }
  .card:hover .frame > img:first-child {
    transform: scale(1.05);
    filter: saturate(1);
  }
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 10, 0.75), transparent 45%);
    pointer-events: none;
  }

  .logo {
    position: absolute;
    left: 50%;
    top: 1.1rem;
    transform: translateX(-50%);
    max-width: 58%;
    max-height: 17%;
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0.95;
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.55));
    z-index: 2;
  }

  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(244, 242, 238, 0.14);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(244, 242, 238, 0.35);
    color: var(--fg);
    transition: background 0.35s, transform 0.45s var(--ease), color 0.35s;
  }
  .play svg {
    margin-left: 3px;
  }
  .card:hover .play {
    background: var(--yellow);
    color: #0a0a0a;
    border-color: var(--yellow);
    transform: translate(-50%, -50%) scale(1.08);
  }

  .soon {
    position: absolute;
    left: 50%;
    bottom: 3.2rem;
    transform: translateX(-50%);
    z-index: 3;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-dim);
    background: rgba(10, 10, 10, 0.72);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    white-space: nowrap;
  }

  .name {
    margin-top: 0.85rem;
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    color: var(--fg-dim);
  }

  /* lightbox */
  .lb {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(92vw, 460px);
    max-height: 92vh;
    overflow: visible;
  }
  .lb::backdrop {
    background: rgba(6, 6, 6, 0.88);
    backdrop-filter: blur(6px);
  }
  .lb video {
    width: 100%;
    max-height: 90vh;
    border-radius: 8px;
    background: #000;
    display: block;
  }
  .lb-x {
    position: absolute;
    top: -2.6rem;
    right: 0;
    font-size: 2rem;
    line-height: 1;
    color: var(--fg);
    opacity: 0.75;
  }
  .lb-x:hover {
    opacity: 1;
  }
</style>
