---
import { useTranslations, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const items = ['s1', 's2', 's3', 's4', 's5', 's6'] as const;
---

<section class="services" id="services">
  <div class="wrap">
    <p class="label pre" data-reveal>{t('services.label')}</p>
    <h2 class="h-sec pre" data-lines>
      <span class="line"><span>{t('services.title')}</span></span>
    </h2>

    <ul class="grid">
      {
        items.map((k, i) => (
          <li class="card pre" data-reveal data-reveal-delay={(i % 3) * 0.08}>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{t(`services.${k}.t` as any)}</h3>
            <p>{t(`services.${k}.d` as any)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services {
    background: var(--bg-soft);
    border-block: 1px solid var(--line);
  }

  .grid {
    list-style: none;
    margin: clamp(3rem, 7vh, 5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .card {
    background: var(--bg-soft);
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    position: relative;
    isolation: isolate;
    transition: background 0.45s var(--ease);
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(255, 226, 18, 0.07), transparent 55%);
    opacity: 0;
    transition: opacity 0.45s var(--ease);
    z-index: -1;
  }
  .card:hover {
    background: var(--bg-card);
  }
  .card:hover::before {
    opacity: 1;
  }

  .n {
    font-family: var(--serif);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    color: var(--yellow);
    display: block;
    margin-bottom: 1.5rem;
  }

  .card h3 {
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    margin-bottom: 0.9rem;
    line-height: 1.15;
  }

  .card p {
    color: var(--fg-dim);
    font-size: 0.94rem;
    line-height: 1.68;
  }
</style>
