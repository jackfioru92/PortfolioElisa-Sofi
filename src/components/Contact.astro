---
import { useTranslations, type Lang } from '../i18n/ui';
import ContactForm from './ContactForm.astro';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const email = 'info@secreative.it';
const phone = '+39 351 437 4436';
const phoneHref = '+393514374436';
const whatsapp = 'https://wa.me/393514374436';
const instagram = 'https://www.instagram.com/se_creative_';
---

<section class="contact" id="contact">
  <div class="glow" aria-hidden="true"></div>

  <div class="wrap">
    <p class="label pre" data-reveal>{t('contact.label')}</p>

    <h2 class="big pre" data-lines>
      <span class="line"><span>{t('contact.title')}</span></span>
    </h2>

    <p class="lead pre" data-reveal data-reveal-delay="0.12">{t('contact.intro')}</p>

    <div class="cards">
      <a class="card pre" href={`mailto:${email}`} data-reveal data-reveal-delay="0.18">
        <span class="k">{t('contact.email')}</span>
        <span class="v">{email}</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M5 12h14M13 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>

      <a class="card pre" href={`tel:${phoneHref}`} data-reveal data-reveal-delay="0.24">
        <span class="k">{t('contact.phone')}</span>
        <span class="v">{phone}</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M5 12h14M13 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <div class="social pre" data-reveal data-reveal-delay="0.28">
      <a class="soc wa" href={whatsapp} target="_blank" rel="noopener noreferrer"
        aria-label={t('social.wa')} title={t('social.wa')}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.25 8.24a8.23 8.23 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.26-8.24Zm-2.6 4.02c-.14 0-.36.05-.55.26-.19.2-.72.7-.72 1.71s.74 1.99.84 2.13c.1.14 1.43 2.28 3.48 3.1 1.7.68 2.05.55 2.42.51.37-.03 1.2-.49 1.36-.96.17-.47.17-.87.12-.96-.05-.08-.19-.13-.4-.24-.2-.1-1.2-.6-1.39-.67-.19-.07-.32-.1-.46.1-.13.21-.52.67-.64.8-.12.14-.24.16-.44.06-.2-.1-.85-.31-1.62-1-.6-.53-1-1.19-1.12-1.39-.12-.2-.01-.31.09-.41.09-.09.2-.24.3-.36.1-.12.13-.2.2-.34.06-.14.03-.26-.02-.36-.05-.1-.45-1.09-.62-1.49-.16-.39-.33-.34-.45-.34l-.38-.01Z"/>
        </svg>
      </a>

      <a class="soc ig" href={instagram} target="_blank" rel="noopener noreferrer"
        aria-label={t('social.ig')} title={t('social.ig')}>
        <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.7"/>
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.7"/>
          <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"/>
        </svg>
      </a>
    </div>

    <div class="formwrap">
      <ContactForm lang={lang} />
    </div>

    <p class="based pre" data-reveal data-reveal-delay="0.3">{t('contact.based')}</p>
  </div>
</section>

<style>
  .social {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .soc {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--fg-dim);
    transition: color 0.3s, border-color 0.3s, background 0.3s, transform 0.3s var(--ease);
  }
  .soc:hover {
    transform: translateY(-3px);
    color: #0a0a0a;
  }
  .soc.wa:hover {
    background: #25d366;
    border-color: #25d366;
  }
  .soc.ig:hover {
    background: linear-gradient(45deg, #f9ce34, #ee2a7b 55%, #6228d7);
    border-color: transparent;
    color: #fff;
  }

  .formwrap {
    max-width: 780px;
    margin: clamp(2.5rem, 6vh, 4rem) auto 0;
    text-align: left;
  }

  .contact {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding-block: clamp(6rem, 16vh, 12rem);
  }

  .glow {
    position: absolute;
    left: 50%;
    bottom: -45%;
    transform: translateX(-50%);
    width: min(110vw, 1100px);
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(255, 226, 18, 0.1), transparent 60%);
    pointer-events: none;
  }

  .contact .label {
    justify-content: center;
  }

  .big {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 8vw, 6rem);
    line-height: 1.05;
    margin-bottom: 1.75rem;
  }
  .big .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .big .line > span {
    display: block;
  }

  .lead {
    margin-inline: auto;
    max-width: 46ch;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
    max-width: 760px;
    margin: clamp(2.5rem, 6vh, 4rem) auto 0;
  }

  .card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.35rem 1rem;
    text-align: left;
    padding: 1.4rem 1.6rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg-soft);
    transition: border-color 0.4s, background 0.4s, transform 0.4s var(--ease);
  }
  .card:hover {
    border-color: var(--yellow);
    background: var(--bg-card);
    transform: translateY(-3px);
  }
  .k {
    grid-column: 1;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .v {
    grid-column: 1;
    font-family: var(--serif);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    color: var(--fg);
    word-break: break-word;
  }
  .card svg {
    grid-column: 2;
    grid-row: 1 / 3;
    color: var(--fg-faint);
    transition: transform 0.4s var(--ease), color 0.4s;
  }
  .card:hover svg {
    color: var(--yellow);
    transform: translateX(4px);
  }

  .based {
    margin-top: 2.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
  }
</style>
