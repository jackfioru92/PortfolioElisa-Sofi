---
import { useTranslations, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const email = 'secreative06@gmail.com';
const phone = '+39 351 437 4436';
const phoneHref = '+393514374436';
---

<section class="contact" id="contact">
  <div class="glow" aria-hidden="true"></div>

  <div class="wrap">
    <p class="label pre" data-reveal>{t('contact.label')}</p>

    <h2 class="big pre" data-lines>
      <span class="line"><span>{t('contact.title')}</span></span>
    </h2>

    <p class="lead pre" data-reveal data-reveal-delay="0.12">{t('contact.intro')}</p>

    <div class="cards">
      <a class="card pre" href={`mailto:${email}`} data-reveal data-reveal-delay="0.18">
        <span class="k">{t('contact.email')}</span>
        <span class="v">{email}</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M5 12h14M13 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>

      <a class="card pre" href={`tel:${phoneHref}`} data-reveal data-reveal-delay="0.24">
        <span class="k">{t('contact.phone')}</span>
        <span class="v">{phone}</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M5 12h14M13 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <p class="based pre" data-reveal data-reveal-delay="0.3">{t('contact.based')}</p>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding-block: clamp(6rem, 16vh, 12rem);
  }

  .glow {
    position: absolute;
    left: 50%;
    bottom: -45%;
    transform: translateX(-50%);
    width: min(110vw, 1100px);
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(255, 226, 18, 0.1), transparent 60%);
    pointer-events: none;
  }

  .contact .label {
    justify-content: center;
  }

  .big {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 8vw, 6rem);
    line-height: 1.05;
    margin-bottom: 1.75rem;
  }
  .big .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .big .line > span {
    display: block;
  }

  .lead {
    margin-inline: auto;
    max-width: 46ch;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
    max-width: 760px;
    margin: clamp(2.5rem, 6vh, 4rem) auto 0;
  }

  .card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.35rem 1rem;
    text-align: left;
    padding: 1.4rem 1.6rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg-soft);
    transition: border-color 0.4s, background 0.4s, transform 0.4s var(--ease);
  }
  .card:hover {
    border-color: var(--yellow);
    background: var(--bg-card);
    transform: translateY(-3px);
  }
  .k {
    grid-column: 1;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .v {
    grid-column: 1;
    font-family: var(--serif);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    color: var(--fg);
    word-break: break-word;
  }
  .card svg {
    grid-column: 2;
    grid-row: 1 / 3;
    color: var(--fg-faint);
    transition: transform 0.4s var(--ease), color 0.4s;
  }
  .card:hover svg {
    color: var(--yellow);
    transform: translateX(4px);
  }

  .based {
    margin-top: 2.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
  }
</style>
