---
import { useTranslations, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = [
  { id: 'p1', img: '/img/slides/s17.webp', year: '2026' },
  { id: 'p2', img: '/img/slides/s14.webp', year: '2026' },
  { id: 'p3', img: '/img/slides/s19.webp', year: '2026' },
  { id: 'p4', img: '/img/slides/s08.webp', year: '2026' },
  { id: 'p5', img: '/img/slides/s10.webp', year: '2026' },
  { id: 'p6', img: '/img/slides/s05.webp', year: '2026' },
] as const;
---

<section class="work" id="work">
  <div class="wrap">
    <p class="label pre" data-reveal>{t('work.label')}</p>
    <div class="head">
      <h2 class="h-sec pre" data-lines>
        <span class="line"><span>{t('work.title')}</span></span>
      </h2>
      <p class="lead pre" data-reveal data-reveal-delay="0.15">{t('work.intro')}</p>
    </div>
  </div>

  <div class="wrap list">
    {
      projects.map((p, i) => (
        <article class="proj pre" data-reveal>
          <div class="shot">
            <img
              src={p.img}
              alt={t(`work.${p.id}.t` as any)}
              width="1600"
              height="900"
              loading="lazy"
              decoding="async"
              data-parallax
            />
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
          </div>

          <div class="info">
            <h3>{t(`work.${p.id}.t` as any)}</h3>
            <dl>
              <div>
                <dt>{t('work.type')}</dt>
                <dd>{t(`work.${p.id}.k` as any)}</dd>
              </div>
              <div>
                <dt>{t('work.scope')}</dt>
                <dd>{t(`work.${p.id}.s` as any)}</dd>
              </div>
            </dl>
            <p class="txt">{t(`work.${p.id}.d` as any)}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .work {
    padding-bottom: clamp(3rem, 6vh, 6rem);
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem 4rem;
    align-items: end;
    margin-bottom: clamp(3rem, 8vh, 6rem);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 11vh, 9rem);
  }

  .proj {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }
  .proj:nth-child(even) .shot {
    order: 2;
  }

  .shot {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: var(--bg-card);
    aspect-ratio: 16 / 9;
  }
  .shot img {
    width: 100%;
    height: 118%;
    object-fit: cover;
    margin-top: -9%;
    transition: transform 0.9s var(--ease);
  }
  .proj:hover .shot img {
    transform: scale(1.035);
  }

  .num {
    position: absolute;
    top: 0.9rem;
    left: 1rem;
    font-family: var(--serif);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--fg);
    background: rgba(10, 10, 10, 0.7);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }

  .info h3 {
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    margin-bottom: 1.5rem;
  }

  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    margin: 0 0 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  dl div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  dt {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--fg);
  }

  .txt {
    color: var(--fg-dim);
    font-size: 0.98rem;
    line-height: 1.72;
    max-width: 54ch;
  }

  @media (max-width: 900px) {
    .head {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .proj,
    .proj:nth-child(even) .shot {
      grid-template-columns: 1fr;
      order: 0;
    }
    .info h3 {
      margin-bottom: 1rem;
    }
  }
</style>
