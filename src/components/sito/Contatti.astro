---
import { studio, type Lingua } from '../../data/studio';
import { t } from '../../data/testi';

interface Props {
  lang: Lingua;
}
const { lang } = Astro.props;
const testi = t(lang);

const m = testi.contatti.modulo;
const wa = `https://wa.me/${studio.whatsapp}?text=${encodeURIComponent(
  testi.contatti.messaggioWhatsapp
)}`;
const ig = `https://instagram.com/${studio.instagram}`;
const privacyHref = lang === 'it' ? '/privacy/' : '/en/privacy/';
---
<section class="sezione contatti" id="contatti">
  <div class="dentro colonne">
    <div>
      <p class="occhiello">{testi.contatti.occhiello}</p>
      <img
        class="nastro"
        src="/img/work/lets-connect.webp"
        alt="Let's connect"
        width="842"
        height="452"
        loading="lazy"
      />
      <p class="invito">{testi.contatti.invito}</p>

      <ul class="recapiti">
        <li><a href={`mailto:${studio.email}`}>{studio.email}</a></li>
        <li><a href={`tel:${studio.telefonoRaw}`}>{studio.telefono}</a></li>
        <li><span>{testi.contatti.luogo}</span></li>
      </ul>

      <div class="social">
        <a class="pill vuoto" href={wa} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
            <path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2z" fill="none"
              stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
            <path
              d="M8.5 7.7c.3 0 .5 0 .7.4l.8 1.7c.1.3 0 .5-.1.7l-.5.6c-.2.2-.2.4 0 .7a7 7 0 003 2.7c.3.1.5.1.7-.1l.6-.6c.2-.2.4-.2.7-.1l1.7.8c.3.2.4.3.4.6 0 1-.8 1.9-1.8 2-1.5.1-3.7-1-5.3-2.6S6.6 10.9 6.6 9.4c0-1 .9-1.7 1.9-1.7z"
              fill="currentColor"></path>
          </svg>
          {testi.contatti.whatsapp}
        </a>

        <a class="pill vuoto" href={ig} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor"
              stroke-width="1.7"></rect>
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.7"
            ></circle>
            <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"></circle>
          </svg>
          {testi.contatti.instagram}
        </a>
      </div>
    </div>

    <form class="modulo" id="modulo" novalidate>
      <p class="titolo-modulo">{m.titolo}</p>

      <div class="riga-due">
        <label>
          <span>{m.nome}<i>*</i></span>
          <input type="text" name="nome" autocomplete="given-name" maxlength="80" required />
          <em class="dice" data-per="nome"></em>
        </label>
        <label>
          <span>{m.cognome}<i>*</i></span>
          <input type="text" name="cognome" autocomplete="family-name" maxlength="80" required />
          <em class="dice" data-per="cognome"></em>
        </label>
      </div>

      <label>
        <span>{m.email}<i>*</i></span>
        <input type="email" name="email" autocomplete="email" maxlength="160" required />
        <em class="dice" data-per="email"></em>
      </label>

      <label>
        <span>{m.provenienza}</span>
        <input type="text" name="provenienza" maxlength="120" placeholder={m.provenienzaAiuto} />
      </label>

      <label>
        <span>{m.messaggio}<i>*</i></span>
        <textarea name="messaggio" rows="5" maxlength="4000" placeholder={m.messaggioAiuto} required
        ></textarea>
        <em class="dice" data-per="messaggio"></em>
      </label>

      {/* campo esca: invisibile a chi legge, lo compilano solo i robot */}
      <div class="esca" aria-hidden="true">
        <label>Sito<input type="text" name="sito" tabindex="-1" autocomplete="off" /></label>
      </div>

      <button class="pill" type="submit" id="invia">
        <span id="etichetta-invia">{m.invia}</span>
        <svg class="freccia" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M4 12L12 4M12 4H5.5M12 4v6.5" fill="none" stroke="currentColor"
            stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <p class="esito" id="esito" role="status" hidden></p>

      <p class="nota">
        {m.nota} <a href={privacyHref}>{m.notaLink}</a>
      </p>
    </form>
  </div>
</section>

<script define:vars={{ d: m }}>
  const modulo = document.getElementById('modulo');
  const bottone = document.getElementById('invia');
  const etichetta = document.getElementById('etichetta-invia');
  const esito = document.getElementById('esito');
  const dice = (campo) => modulo.querySelector(`.dice[data-per="${campo}"]`);

  const valore = (campo) => String(new FormData(modulo).get(campo) || '').trim();

  function pulisci() {
    modulo.querySelectorAll('.dice').forEach((e) => (e.textContent = ''));
    modulo.querySelectorAll('.storto').forEach((e) => e.classList.remove('storto'));
  }

  /** Gli stessi controlli del servizio, fatti prima di disturbare la rete. */
  function controlla() {
    const errori = {};
    for (const campo of ['nome', 'cognome', 'email', 'messaggio']) {
      if (!valore(campo)) errori[campo] = d.obbligatorio;
    }
    const email = valore('email');
    if (email && !/^[^@\s]+@[^@\s.]+\.[^@\s]{2,}$/.test(email)) errori.email = d.emailNo;
    const messaggio = valore('messaggio');
    if (messaggio && messaggio.length < 10) errori.messaggio = d.corto;
    return errori;
  }

  function mostra(errori) {
    for (const [campo, testo] of Object.entries(errori)) {
      const e = dice(campo);
      if (e) e.textContent = testo;
      modulo.querySelector(`[name="${campo}"]`)?.classList.add('storto');
    }
    modulo.querySelector('.storto')?.focus();
  }

  function annuncia(ok, titolo, testo) {
    esito.hidden = false;
    esito.className = 'esito ' + (ok ? 'bene' : 'male');
    esito.innerHTML = `<b></b> <span></span>`;
    esito.querySelector('b').textContent = titolo;
    esito.querySelector('span').textContent = testo;
  }

  modulo.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    pulisci();
    esito.hidden = true;

    const errori = controlla();
    if (Object.keys(errori).length) return mostra(errori);

    bottone.disabled = true;
    etichetta.textContent = d.invio;

    try {
      const r = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nome: valore('nome'),
          cognome: valore('cognome'),
          email: valore('email'),
          provenienza: valore('provenienza'),
          messaggio: valore('messaggio'),
          sito: valore('sito'), // l'esca: se è pieno, il servizio scarta in silenzio
        }),
      });

      if (r.ok) {
        modulo.reset();
        annuncia(true, d.okTitolo, d.okTesto);
      } else if (r.status === 429) {
        annuncia(false, d.koTitolo, d.troppe);
      } else if (r.status === 422) {
        // il servizio dice quali campi non gli tornano
        const corpo = await r.json().catch(() => ({}));
        const campi = Array.isArray(corpo.campi) ? corpo.campi : [];
        if (campi.length) mostra(Object.fromEntries(campi.map((c) => [c, d.obbligatorio])));
        else annuncia(false, d.koTitolo, d.koTesto);
      } else {
        annuncia(false, d.koTitolo, d.koTesto);
      }
    } catch {
      // rete assente o servizio irraggiungibile
      annuncia(false, d.koTitolo, d.koTesto);
    } finally {
      bottone.disabled = false;
      etichetta.textContent = d.invia;
    }
  });

  /* appena si corregge un campo, il suo avviso sparisce */
  modulo.querySelectorAll('input, textarea').forEach((c) =>
    c.addEventListener('input', () => {
      c.classList.remove('storto');
      const e = dice(c.name);
      if (e) e.textContent = '';
    })
  );
</script>

<style>
  .contatti {
    background: var(--giallo);
  }

  .colonne {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .nastro {
    width: min(100%, 340px);
    height: auto;
    margin: 0 0 1.75rem -0.5rem;
    rotate: -1deg;
  }

  .invito {
    max-width: 26rem;
    margin: 0 0 2rem;
  }

  .recapiti {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .recapiti li {
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.35rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .recapiti a {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 100% 1.5px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.3s;
  }

  .recapiti a:hover {
    background-size: 0% 1.5px;
  }

  .recapiti li:last-child {
    font-weight: 500;
    font-size: 0.95rem;
    opacity: 0.65;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .social .pill {
    padding: 0.7rem 1.2rem;
    font-size: 0.72rem;
  }

  /* ---- modulo ---- */
  .modulo {
    display: grid;
    gap: 1.4rem;
  }

  .modulo label {
    display: grid;
    gap: 0.5rem;
  }

  .modulo span {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .modulo i {
    font-style: normal;
    color: var(--lampone);
  }

  .modulo input,
  .modulo textarea {
    padding: 0.7rem 0;
    border: 0;
    border-bottom: 1.5px solid rgba(11, 11, 11, 0.35);
    background: transparent;
    font-size: 1rem;
    transition: border-color 0.25s;
  }

  .modulo textarea {
    padding: 0.7rem 0.9rem;
    border: 1.5px solid rgba(11, 11, 11, 0.35);
    border-radius: 10px;
    resize: vertical;
  }

  .modulo input:focus,
  .modulo textarea:focus {
    outline: none;
    border-color: var(--nero);
  }

  .modulo .pill {
    justify-self: start;
  }

  .titolo-modulo {
    margin: 0 0 -0.4rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .riga-due {
    display: grid;
    gap: 1.4rem;
  }

  /* l'avviso sotto al campo: occupa spazio solo quando c'è qualcosa da dire */
  .dice {
    font-size: 0.78rem;
    font-weight: 600;
    font-style: normal;
    color: #8f1d1d;
  }

  .dice:empty {
    display: none;
  }

  .modulo .storto {
    border-color: #8f1d1d;
  }

  /* il campo esca: fuori dallo schermo, non lo vede nessuno tranne i robot */
  .esca {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .esito {
    display: grid;
    gap: 0.15rem;
    margin: -0.4rem 0 0;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .esito b {
    font-weight: 700;
  }

  .esito.bene {
    background: var(--nero);
    color: var(--giallo);
  }

  .esito.male {
    background: #fbe3e3;
    color: #7d1a1a;
  }

  .nota {
    margin: -0.4rem 0 0;
    font-size: 0.78rem;
    line-height: 1.55;
    opacity: 0.68;
  }

  .nota a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (min-width: 460px) {
    .riga-due {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .colonne {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
