---
import { type Lingua } from '../../data/studio';
import { t } from '../../data/testi';

interface Props {
  lang: Lingua;
}
const { lang } = Astro.props;
const testi = t(lang);
const p = testi.privacy;
const casa = lang === 'it' ? '/' : '/en/';
---

<article class="sezione carta">
  <div class="dentro">
    <a class="indietro" href={casa}>
      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
        <path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.8"
          stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {p.torna}
    </a>

    <h1>{p.titolo}<span class="corsivo">{p.titoloCorsivo}</span></h1>
    <p class="quando">{p.aggiornata}</p>

    <p class="sommario">{p.sommario}</p>

    {
      p.sezioni.map((s) => (
        <section class="blocco">
          <h2>{s.titolo}</h2>
          {s.testo.map((riga) => (
            <p>{riga}</p>
          ))}
        </section>
      ))
    }
  </div>
</article>

<style>
  .carta {
    background: var(--giallo);
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  .dentro {
    max-width: 46rem;
  }

  .indietro {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
    transition: opacity 0.25s;
  }

  .indietro:hover {
    opacity: 1;
  }

  h1 {
    font-size: clamp(2.2rem, 1.2rem + 3vw, 3.6rem);
  }

  .quando {
    margin: 1rem 0 2.5rem;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .sommario {
    margin: 0 0 3rem;
    padding: 1.25rem 1.4rem;
    border-left: 3px solid var(--nero);
    background: rgba(11, 11, 11, 0.06);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .blocco {
    margin-bottom: 2.5rem;
  }

  .blocco h2 {
    margin-bottom: 0.9rem;
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    letter-spacing: -0.02em;
  }

  .blocco p {
    margin: 0 0 0.85rem;
    max-width: 40rem;
    opacity: 0.88;
  }

  .blocco p:last-child {
    margin-bottom: 0;
  }
</style>
