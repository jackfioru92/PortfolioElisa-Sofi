---
import { type Lingua } from '../../data/studio';
import { t } from '../../data/testi';

interface Props {
  lang: Lingua;
}
const { lang } = Astro.props;
const testi = t(lang);

/* un segno per ciascun servizio, nello stesso tratto della bozza */
const segni = [
  'M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1',
  'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
  'M8.5 4a4.5 4.5 0 100 9 4.5 4.5 0 000-9zM15.5 11a4.5 4.5 0 100 9 4.5 4.5 0 000-9z',
  'M5 20c3-9 8-13 14-14M5 20l-1 1M8 6a3 3 0 106 0 3 3 0 00-6 0',
  'M2 5h13v10H2zM2 8h13M6 19h5M8.5 15v4M18 6h4v13h-4z',
];
---
<section class="sezione servizi" id="servizi">
  <div class="dentro">
    <header class="testata">
      <div>
        <p class="occhiello">{testi.servizi.occhiello}</p>
        <h2 data-rivela>
          <Fragment set:html={testi.servizi.titolo} /><span class="corsivo"
            >{testi.servizi.titoloCorsivo}</span
          >
        </h2>
      </div>
      <p class="intro" data-scrivi>{testi.servizi.intro}</p>
    </header>

    <ul class="righe">
      {
        testi.servizi.voci.map((s, i) => (
          <li style={`--posto:${i}`} data-riga>
            <span class="numero">{String(i + 1).padStart(2, '0')}</span>
            <svg class="segno" viewBox="0 0 24 24" aria-hidden="true">
              <path d={segni[i]} fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <h3>{s.titolo}</h3>
            <p>{s.testo}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .servizi {
    background: var(--giallo);
  }

  .testata {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: clamp(2.25rem, 4vw, 3.5rem);
  }

  .intro {
    max-width: 28rem;
    margin: 0;
  }

  .righe {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(11, 11, 11, 0.22);
  }

  .righe li {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1.1fr) minmax(0, 1.4fr);
    align-items: center;
    gap: clamp(0.9rem, 3vw, 2.5rem);
    padding-block: clamp(1.1rem, 2.4vw, 1.8rem);
    border-bottom: 1px solid rgba(11, 11, 11, 0.22);
    transition: background 0.3s, padding-inline 0.3s;
  }

  /* entrano una dopo l'altra, dal basso */
  .righe li[data-riga] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--posto) * 0.09s),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--posto) * 0.09s),
      background 0.3s;
  }
  .righe li[data-riga].entrata {
    opacity: 1;
    transform: none;
  }
  .no-js .righe li[data-riga] {
    opacity: 1;
    transform: none;
  }

  .righe li:hover {
    background: rgba(11, 11, 11, 0.055);
    padding-inline: clamp(0.5rem, 1.4vw, 1.1rem);
  }

  .segno {
    width: clamp(20px, 2.2vw, 26px);
    height: auto;
    color: rgba(11, 11, 11, 0.55);
    transition: color 0.3s, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .righe li:hover .segno {
    color: var(--nero);
    transform: rotate(90deg);
  }

  .numero {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: rgba(11, 11, 11, 0.45);
    font-variant-numeric: tabular-nums;
  }


  .righe p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    opacity: 0.78;
  }

  @media (min-width: 900px) {
    .testata {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
</style>

<script>
  const righe = document.querySelectorAll<HTMLElement>('.righe li[data-riga]');
  if (righe.length) {
    const lista = righe[0].parentElement!;
    const fermo = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (fermo) {
      righe.forEach((r) => r.classList.add('entrata'));
    } else {
      // si osserva l'elenco, non ogni riga: cosi' partono in cascata
      new IntersectionObserver(
        (voci, osservatore) => {
          for (const v of voci) {
            if (!v.isIntersecting) continue;
            osservatore.disconnect();
            righe.forEach((r) => r.classList.add('entrata'));
          }
        },
        { threshold: 0.15 }
      ).observe(lista);
    }
  }
</script>
