---
import { servizi } from '../../data/studio';

/* un segno per ciascun servizio, nello stesso tratto della bozza */
const segni = [
  'M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1',
  'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
  'M8.5 4a4.5 4.5 0 100 9 4.5 4.5 0 000-9zM15.5 11a4.5 4.5 0 100 9 4.5 4.5 0 000-9z',
  'M5 20c3-9 8-13 14-14M5 20l-1 1M8 6a3 3 0 106 0 3 3 0 00-6 0',
];
---

<section class="sezione servizi" id="servizi">
  <div class="dentro">
    <header class="testata">
      <div>
        <p class="occhiello">Cosa facciamo</p>
        <h2>Dal concept<br /> alla <span class="corsivo">cultura.</span></h2>
      </div>
      <p class="intro">
        Aiutiamo i brand a distinguersi con una comunicazione coerente, esperienze
        digitali e contenuti che creano connessioni reali.
      </p>
    </header>

    <ul class="griglia">
      {
        servizi.map((s, i) => (
          <li>
            <svg class="segno" viewBox="0 0 24 24" aria-hidden="true">
              <path d={segni[i]} fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <h3>{s.titolo}</h3>
            <p>{s.testo}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .servizi {
    background: var(--giallo);
  }

  .testata {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: clamp(2.25rem, 4vw, 3.5rem);
  }

  .intro {
    max-width: 28rem;
    margin: 0;
  }

  .griglia {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: clamp(0.9rem, 1.6vw, 1.35rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .griglia li {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: clamp(1.4rem, 2.2vw, 1.9rem);
    border: 1.4px solid rgba(11, 11, 11, 0.28);
    border-radius: 12px;
    transition: background 0.28s, border-color 0.28s, transform 0.28s;
  }

  .griglia li:hover {
    background: var(--nero);
    border-color: var(--nero);
    color: var(--giallo-chiaro);
    transform: translateY(-4px);
  }

  .segno {
    width: 30px;
    height: 30px;
    margin-bottom: 1.6rem;
  }

  .griglia p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    opacity: 0.78;
  }

  @media (min-width: 900px) {
    .testata {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
