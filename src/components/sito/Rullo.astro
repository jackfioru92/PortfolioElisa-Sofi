---
import type { Lingua } from '../../data/studio';
import { t } from '../../data/testi';

interface Props {
  lang: Lingua;
}
const { lang } = Astro.props;
const testi = t(lang);
const r = testi.rullo;

/**
 * Due nastri che scorrono di lato in direzioni opposte, come nella versione
 * mandata dal cliente: sopra le parole piene in giallo separate da un
 * asterisco, sotto le stesse in corsivo a contorno vuoto.
 *
 * Ogni nastro contiene la lista due volte e scorre esattamente di metà: al
 * termine si ritrova nella posizione di partenza e riparte senza stacco.
 */
const giro = [...r.parole, ...r.parole];
---

<section class="sezione rullo" id="rullo" aria-labelledby="rullo-titolo">
  <div class="dentro">
    <header class="testata">
      <div>
        <p class="occhiello">{r.occhiello}</p>
        <h2 id="rullo-titolo" data-rivela>
          <Fragment set:html={r.titolo} /><span class="corsivo">{r.titoloCorsivo}</span>
        </h2>
      </div>
      <p class="intro" data-scrivi>{r.intro}</p>
    </header>
  </div>

  <!-- l'elenco vero, per chi legge con la tastiera o con uno screen reader -->
  <ul class="solo-lettori">
    {r.parole.map((p) => <li>{p}</li>)}
  </ul>

  <div class="nastri" aria-hidden="true">
    <div class="nastro pieno">
      <div class="scorre">
        {
          giro.map((p) => (
            <span class="parola">
              {p}
              <i class="stella">✻</i>
            </span>
          ))
        }
      </div>
    </div>

    <div class="nastro vuoto">
      <div class="scorre indietro">
        {
          giro.map((p) => (
            <span class="parola">
              {p}
              <i class="barra">/</i>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .rullo {
    background: var(--nero);
    color: var(--bianco);
    overflow: hidden;
    padding-block: clamp(3.5rem, 9vw, 6rem);
  }

  .testata {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem 3rem;
    align-items: end;
  }

  .rullo .occhiello {
    color: var(--giallo);
  }
  .rullo h2 {
    color: var(--bianco);
  }
  .rullo .intro {
    color: rgba(255, 253, 247, 0.62);
    max-width: 44ch;
  }

  .nastri {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: clamp(0.1rem, 0.5vw, 0.4rem);
  }

  .nastro {
    overflow: hidden;
  }

  .scorre {
    display: flex;
    width: max-content;
    animation: nastro 34s linear infinite;
  }
  .scorre.indietro {
    animation-direction: reverse;
    animation-duration: 40s; /* leggermente diversa: i due nastri non vanno a tempo */
  }

  @keyframes nastro {
    to {
      /* metà esatta: la lista è ripetuta due volte */
      transform: translateX(-50%);
    }
  }

  .parola {
    display: inline-flex;
    align-items: center;
    gap: clamp(0.5rem, 1.6vw, 1.5rem);
    padding-right: clamp(0.5rem, 1.6vw, 1.5rem);
    white-space: nowrap;
    line-height: 1.05;
  }

  /* nastro di sopra: pieno, giallo, grasso */
  .pieno .parola {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(2.1rem, 7.2vw, 5.6rem);
    letter-spacing: -0.03em;
    color: var(--giallo);
  }
  .stella {
    font-style: normal;
    font-size: 0.42em;
    color: var(--fucsia);
    translate: 0 -0.15em;
  }

  /* nastro di sotto: corsivo, solo il contorno */
  .vuoto .parola {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.9rem, 6.6vw, 5.2rem);
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 253, 247, 0.38);
  }
  .barra {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 253, 247, 0.22);
  }

  .solo-lettori {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 860px) {
    .testata {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  /* chi ha chiesto meno movimento vede le parole ferme, senza scorrimento */
  @media (prefers-reduced-motion: reduce) {
    .scorre {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      padding-inline: var(--bordo);
    }
    .vuoto {
      display: none;
    }
  }
</style>
