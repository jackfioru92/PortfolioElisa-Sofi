# Copia questo file in `deploy.env` e mettici i dati del tuo server.
# `deploy.env` NON viene pubblicato su GitHub (è in .gitignore).

# utente@indirizzo del server
HOST="utente@indirizzo-del-server"

# cartella servita da nginx
DEST="/var/www/secreative"

# dominio principale, per la verifica finale
SITE="secreative.it"
